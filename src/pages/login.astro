---
import { LoginForm } from "@/components/form/LoginForm";
import AppLayout from "@/components/layout/AppLayout.astro";
import AuthLayout from "@/components/layout/AuthLayout.astro";

const refreshToken = Astro.cookies.get("refreshToken");

if (refreshToken) {
  return Astro.redirect("/");
}
---

<AppLayout>
  <AuthLayout slot="main">
    <LoginForm client:load />
  </AuthLayout>
</AppLayout>
