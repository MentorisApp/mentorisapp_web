---
export const prerender = false;

import { LoginForm } from "@/components/form/forms/LoginForm";
import AppLayout from "@/layout/AppLayout.astro";

const refreshToken = Astro.cookies.get("refreshToken");

if (refreshToken) {
  return Astro.redirect("/");
}
---

<AppLayout>
  <div slot="main" class="flex h-lvh w-lvw">
    <div class="flex-1">
      <LoginForm client:load />
    </div>
    <div class="flex-1 bg-neutral-200"></div>
  </div>
</AppLayout>
