---
import { HeroSearch } from "@/components/HeroSearch";
import NavigationBar from "@/components/NavigationBar.astro";
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout>
  <NavigationBar slot="header" />
  <div slot="main">
    <section class="bg-primary/50 flex h-[60dvh] w-full flex-col items-center justify-center gap-4">
      <h1 class="text-text text-4xl font-semibold">Učitelji za svaki predmet i svaku dob</h1>
      <p class="text-text-muted/80 text-xl leading-loose">
        Privatne instrukcije iz matematike – brzo i jednostavno
      </p>

      <div class="bg-surface h-20 w-[50vw] rounded-full"></div>
      <!-- <HeroSearch client:load /> -->
    </section>
  </div>
</AppLayout>
