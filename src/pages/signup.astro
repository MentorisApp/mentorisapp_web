---
import { SignupForm } from "@/components/form/forms/SignupForm";
import AppLayout from "@/layout/AppLayout.astro";

const refreshToken = Astro.cookies.get("refreshToken");

if (refreshToken) {
  return Astro.redirect("/");
}
---

<AppLayout>
  <div slot="main">
    <div class="flex h-lvh w-full items-center justify-center">
      <SignupForm client:load />
    </div>
  </div>
</AppLayout>
