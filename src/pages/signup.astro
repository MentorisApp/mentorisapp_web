---
import AppLayout from "@/components/layout/AppLayout.astro";
import { OAuthLogin } from "@/components/OAuthLogin";
import { SignupForm } from "@/modules/signup/SignupForm";
import { Card } from "@/ui/Card";
import { Divider } from "@/ui/Divider";

const refreshToken = Astro.cookies.get("refreshToken");

if (refreshToken) {
  return Astro.redirect("/");
}
---

<AppLayout>
  <div slot="main" class="grid min-h-lvh w-full place-items-center">
    <Card size="lg" className="min-w-[540px]">
      <h2 class="mb-7 text-center text-3xl font-medium">Kreiraj račun</h2>
      <SignupForm client:load />
      <Divider label="ili nastavi s" />
      <OAuthLogin />
    </Card>
  </div>
</AppLayout>
