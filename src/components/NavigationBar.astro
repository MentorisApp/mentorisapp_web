---
import { UserMenu } from "./UserMenu";

const { user } = Astro.locals;
---

<header class="w-full px-4">
  <nav class="flex w-full flex-wrap items-start justify-between py-4 text-sm">
    <div>
      <a
        class="flex-none text-xl font-semibold focus:opacity-80 focus:outline-hidden sm:order-1 dark:text-white"
        href="/"
      >
        Mentoris
      </a>
    </div>
    <div>
      <UserMenu user={user} client:load />
    </div>
  </nav>
</header>
