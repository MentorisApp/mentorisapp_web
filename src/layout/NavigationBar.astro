---
import { UserMenu } from "../components/UserMenu";

const { user } = Astro.locals;
---

<header class="flex w-full py-4 text-sm dark:bg-neutral-800">
  <nav class="mx-auto flex w-full basis-full flex-wrap items-center justify-between px-6">
    <div>
      <a
        class="flex-none text-xl font-semibold focus:opacity-80 focus:outline-hidden sm:order-1 dark:text-white"
        href="/"
      >
        Mentoris
      </a>
    </div>
    <div>
      <UserMenu user={user} client:load />
    </div>
  </nav>
</header>
